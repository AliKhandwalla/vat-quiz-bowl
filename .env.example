# Supabase Dashboard > Project Settings > API. These two values are browser-safe.
VITE_SUPABASE_URL=https://your-project.supabase.co
# Use the project origin only: no username/password, API path, query, or fragment.
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# A legacy anon key may be used instead of the publishable key:
# VITE_SUPABASE_ANON_KEY=your-legacy-anon-key
# Never put a service_role key, sb_secret key, or database password in VITE_*.
# Enable anonymous sign-ins and apply the three SQL migrations in order (README.md).
# Vercel: configure these same names in Project Settings > Environment Variables,
# for each intended environment, then rebuild. Values are public in the bundle.
# If both key variables are set, the publishable key takes precedence.
# Values are trimmed consistently by Vite's build guard and the browser adapter.
# See docs/DEPLOYMENT.md for production Auth, Realtime, and acceptance steps.
